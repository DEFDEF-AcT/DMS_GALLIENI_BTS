# Copier ce fichier en .env.local et renseigner les valeurs.
# IMPORTANT : utilisez le MÊME projet Supabase que l'application DMS principale
# (dms-gallieni) afin de partager les comptes et les ordres de réparation.
# (Supabase → Project Settings → API)
# La clé anon est PUBLIQUE par conception : la sécurité repose sur les politiques RLS.
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON
